  "prerequisites": [],
  "brief": {
    "learner": "A beginner who knows loops and lists.",
    "can_do": "Explain how a table of small answers builds the answer to a bigger problem.",
    "question": "How many ways are there to climb five stairs, one or two at a time?",
    "problem": "A staircase of five stairs. Each move climbs one stair or two.",
    "naive_attempt": "List every route by hand. It works for three stairs, and then the list gets too long to trust.",
    "turning_point": "The ways to reach a stair are the ways to reach the two stairs below it, added together.",
    "check_question": "Stair 4 can be reached 5 ways and stair 5 in 8. How many ways reach stair 6?",
    "check_answer": "Thirteen: five plus eight."
  },
  "map": null,
  "trace": {
    "code": {
      "title": "stairs.py",
      "source": "def ways(n):\n    table = [0] * (n + 1)\n    table[0] = 1\n    table[1] = 1\n    for i in range(2, n + 1):\n        table[i] = table[i - 1] + table[i - 2]\n    return table[n]"
    },
