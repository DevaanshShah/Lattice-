  "skill_id": "algorithm_explainer",
  "learning_objective": "Explain how a table of smaller amounts finds the fewest coins for a bigger one.",
  "audience": "A beginner who knows loops and lists.",
  "prerequisites": [],
  "brief": {
    "learner": "A beginner who knows loops and lists.",
    "can_do": "Explain how a table of smaller amounts finds the fewest coins for a bigger one.",
    "question": "Is taking the biggest coin first always the fewest coins?",
    "problem": "Make 6 from coins worth 1, 3 and 4, using as few coins as possible.",
    "naive_attempt": "Take the biggest coin that fits, again and again: a 4, then a 1, then another 1. Three coins.",
    "turning_point": "The fewest coins for an amount is one coin more than the fewest for a smaller amount.",
    "check_question": "With coins of 1, 3 and 4, what is the fewest coins that make 7?",
    "check_answer": "Two: a three and a four."
  },
  "map": null,
  "trace": {
    "code": {
      "title": "coins.py",
      "source": "def fewest(coins, amount):\n    best = [0] * (amount + 1)\n    for a in range(1, amount + 1):\n        smaller = [best[a - c]\n                   for c in coins if c <= a]\n        best[a] = min(smaller) + 1\n    return best[amount]"
    },
