          "id": "code",
          "kind": "code",
          "role": "context",
          "label": "coins.py",
          "payload": {
            "source": "def fewest(coins, amount):\n    best = [0] * (amount + 1)\n    for a in range(1, amount + 1):\n        smaller = [best[a - c]\n                   for c in coins if c <= a]\n        best[a] = min(smaller) + 1\n    return best[amount]"
          }
        },
