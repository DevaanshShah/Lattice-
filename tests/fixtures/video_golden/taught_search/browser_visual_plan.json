{
  "schema_version": 2,
  "topic": "Why binary search needs so few checks",
  "skill_id": "algorithm_explainer",
  "scenes": [
    {
      "lesson_scene_id": "s1",
      "pattern": "workflow",
      "render_mode": "browser",
      "objects": [
        {
          "id": "code",
          "kind": "code",
          "role": "context",
          "label": "find.py",
          "payload": {
            "source": "def find(items, target):\n    low, high = 0, len(items) - 1\n    while low <= high:\n        mid = (low + high) // 2\n        if items[mid] == target:\n            return mid\n        if items[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return -1"
          }
        },
        {
          "id": "numbers",
          "kind": "array",
          "role": "input",
          "label": "Sorted list",
          "payload": {
            "items": [
              3,
              8,
              12,
              17,
              21,
              30,
              44
            ]
          }
        },
        {
          "id": "target",
