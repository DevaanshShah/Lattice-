{
  "schema_version": 2,
  "topic": "How sharding splits a huge database across machines",
  "skill_id": "architecture_explainer",
  "learning_objective": "Explain how sharding splits rows across machines by a shard key, and why that lets a huge table scale.",
  "audience": "A beginner programmer who knows a database stores rows in tables and can write simple queries, but has never had to think about what happens when data gets too big for one machine.",
  "prerequisites": [],
  "brief": {
    "learner": "A beginner programmer who knows a database stores rows in tables and can write simple queries, but has never had to think about what happens when data gets too big for one machine.",
    "can_do": "Explain how sharding splits rows across machines by a shard key, and why that lets a huge table scale.",
    "question": "How does one giant table fit on many machines?",
    "problem": "An online shop's orders table has grown to 900 million rows, and its single database server is out of disk and slow at every query.",
    "naive_attempt": "Buy a bigger server and keep one copy of the table, but it runs out of disk again and every query still hits one machine.",
    "turning_point": "Split the rows by a key like customer_id so each machine holds one slice and only answers for its own slice.",
    "check_question": "Which rows does the machine for shard 3 hold?",
    "check_answer": "Only the rows whose shard key maps to shard 3."
  },
