# Copy to .env and fill in. All vars are prefixed LATTICE_.
# Generator and critic are DIFFERENT, swappable models (strong coder writes; cheap vision model checks).
# Not called in M0 — wired for M1+.

LATTICE_LLM_BASE_URL=https://openrouter.ai/api/v1
LATTICE_LLM_API_KEY=
LATTICE_LLM_MODEL=openai/gpt-4o-mini
LATTICE_CRITIC_MODEL=openai/gpt-4o-mini

# Render sandbox (Q5 = containerized). Keep network OFF (the sandbox invariant).
LATTICE_RENDER_NETWORK=false

# TTS (Q3, used from M4)
LATTICE_TTS_ENGINE=gtts

# Admin console (/admin): users, spend and per-user activity. Leave EMPTY for local dev and the
# console answers only to localhost; set a long random value on any deployed instance, or the
# dashboard is public to whoever guesses the URL.
LATTICE_ADMIN_TOKEN=

# Google sign-in via Supabase Auth (see docs/google-sign-in.md). Leave the URL EMPTY and the app
# runs with no sign-in, as before. Fill URL + anon key and every page needs a Google account.
LATTICE_SUPABASE_URL=
LATTICE_SUPABASE_ANON_KEY=
# Optional (legacy HS256 projects): verifies tokens offline instead of asking Supabase.
LATTICE_SUPABASE_JWT_SECRET=
# false = guests can still use the app; signing in is offered, not demanded.
LATTICE_AUTH_REQUIRED=true
# Invite list (comma-separated emails, or @domain for a whole school/company). Empty = any Google
# account may sign in. Put your OWN email in it, or you lock yourself out.
LATTICE_AUTH_ALLOWED_EMAILS=
# Split deploy only: the origin(s) of a separately hosted frontend, e.g. https://app.example.com (comma-separated).
# Empty = this server serves the UI itself. See docs/DEPLOY.md "Split deploy".
LATTICE_FRONTEND_ORIGINS=
# The address users reach the app at. Required in production (the OAuth return address).
LATTICE_PUBLIC_URL=

# Object storage for finished videos — Cloudflare R2 (see docs/r2-setup.md).
# Leave EMPTY to keep everything on local disk (fine locally; on a PaaS every redeploy wipes it).
LATTICE_R2_ACCOUNT_ID=
LATTICE_R2_BUCKET=lattice-videos
LATTICE_R2_ACCESS_KEY_ID=
LATTICE_R2_SECRET_ACCESS_KEY=
# Optional: a public bucket domain (r2.dev or your own). Empty = private bucket + presigned URLs.
LATTICE_R2_PUBLIC_BASE=
# Delete the local copy after a successful upload. Only for small-disk deploys — the scene editor,
# re-export and restitch all read the local file and will have to pull it back.
LATTICE_R2_DELETE_LOCAL=false

# What a public instance exposes. Both default to OFF; turn them on only on your own machine.
# The generated API docs (/docs, /redoc, /openapi.json) map every endpoint.
LATTICE_API_DOCS=false
# The developer console: each scene's generated code, the exact model prompts and the raw job log.
LATTICE_DEV_CONSOLE=false

# Per-account limits, a rolling 24 hours, enforced only with sign-in on (web/quota.py). 0 = unlimited.
LATTICE_QUOTA_VIDEOS_PER_DAY=5          # whole videos: build, deck, lesson video
LATTICE_QUOTA_EDITS_PER_DAY=40          # scene regenerate / tweak / narration / insert
LATTICE_QUOTA_SPEND_USD_PER_DAY=1.0     # model-spend ceiling per account (also covers chat and plans)
LATTICE_QUOTA_GLOBAL_SPEND_USD_PER_DAY=3.0   # ALL accounts together: the real bound on your bill when sign-in is open
# Comma-separated emails or user ids that are never limited: put the owner's own Google email here.
LATTICE_QUOTA_EXEMPT=
